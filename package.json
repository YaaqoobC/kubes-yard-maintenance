{
  "name": "kubes-yard-maintenance",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.22.0"
  },
  "scripts": {
    "dev": "react-router dev --host 127.0.0.1",
    "build": "react-router build && node scripts/finalize-static.mjs",
    "preview": "vite preview --config vite.preview.config.ts",
    "typecheck": "react-router typegen && tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "playwright test",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm run build && npm test"
  },
  "overrides": {
    "minimatch": "^11.0.1"
  },
  "dependencies": {
    "@fontsource-variable/dm-sans": "^5.3.0",
    "@fontsource-variable/manrope": "^5.3.0",
    "isbot": "^5",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^8.5.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.65.0",
    "@react-router/dev": "^8.5.1",
    "@react-router/node": "^8.5.1",
    "@tailwindcss/vite": "^4.3.5",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^10.14.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.14.0",
    "prettier": "^3.10.0",
    "tailwindcss": "^4.3.5",
    "typescript": "~6.0.0",
    "typescript-eslint": "^8.72.2",
    "vite": "^8.3.8"
  }
}
